<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="AtThisPoint.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <style>
        /* General Page Styling */
        body {
            margin: 0;
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
            overflow-x: hidden;
        }

        /* Taskbar */
        .taskbar {
            background-color: #003366; /* Dark blue */
            color: #fff;
            padding: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between; /* Space out sections */
        }

        .logo {
            display: flex;
            align-items: center;
        }

        .logo img {
            height: 40px;
            margin-right: 15px;
        }

        .navigation {
            display: flex;
            gap: 15px; /* Space between links */
        }

        .right-nav {
            display: flex;
            gap: 15px;
        }

        .navigation a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
        }

        .right-nav a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
        }

        .navigation a:hover {
            background-color: #575757;
            border-radius: 5px;
        }

        .right-nav a:hover{
            background-color: #575757;
            border-radius: 5px;

        }

        /* Right-aligned Navigation Links */
        .right-nav {
            margin-left: auto;
            display: flex;
            gap: 15px;
        }

        /* Dropdown Styling */
        .dropdown {
            position: relative;
            display: flex; /* Change to flex for alignment */
            align-items: center; /* Center-align dropdown with other links */
        }

        .dropbtn {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%; /* Position dropdown below the button */
            left: 0;
            background-color: #003366; /* Dark blue */
            min-width: 150px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }

        .dropdown-content a {
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            display: block;
        }

        .dropdown-content a:hover {
            background-color: #575757;
            border-radius: 5px;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }



        /* Footer */
        footer {
            background-color: #003366; /* Dark blue */
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 0.9em;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Taskbar with Logo and Navigation Links -->
        <div class="taskbar">
            <div class="logo">
                <img src="~/photos/logo.png" alt="Company Logo" runat="server" />

            </div>
            <div class="navigation">
                <a runat="server" href="~/">Home</a>
                <a runat="server" id="mainmenu" href="Customers/Menu" Visible="false"><strong>Menu</strong></a>
                <a runat="server" id="cProfile" href="Customers/Profile" Visible="false"><strong>Profile</strong></a>
                <a runat="server" id="cPackages" href="Customers/Packages" Visible="false"><strong>Packages</strong></a>
                <a runat="server" id="cPayment" href="Customers/Payment" Visible="false"><strong>Payment</strong></a>

                <div class="dropdown" runat="server" id="bookingsDropdown" visible="false">
                    <a href="#" class="dropbtn">Bookings</a>
                    <div class="dropdown-content">
                        <a runat="server" id="learnersLink" href="Customers/BookingLearners" visible="false">Learners</a>
                        <a runat="server" id="driversLink" href="Customers/BookingsDrivers" visible="false">Code 8 </a>
                        <a runat="server" id="driverslink10" href="Customers/BookingsDrivers10" visible="false">Code 10</a>
                    </div>
                </div>

                <a runat="server" id="mReport" href="Manager/Reports" Visible="false"><strong>Reports</strong></a>

                <a runat="server" id="iSchedule" href="Instructor/Schedule" Visible="false"><strong>Schedule</strong></a>

                <%--<a runat="server" href="~/Contact">Contact</a>--%>
            </div>
            <asp:LoginView runat="server" ViewStateMode="Disabled">
                <AnonymousTemplate>
                    <div class="right-nav">
                        <a runat="server" href="~/Account/Register">Register</a>
                        <a runat="server" href="~/Account/Login">Log in</a>
                    </div>
                </AnonymousTemplate>
                <LoggedInTemplate>
                    <div class="right-nav">
                        <a runat="server" href="~/Account/Manage" title="Manage your account">Hello, <%: Context.User.Identity.GetUserName()  %> !</a>
                        <asp:LoginStatus runat="server" LogoutAction="Redirect" LogoutText="Log off" LogoutPageUrl="~/" OnLoggingOut="Unnamed_LoggingOut" />
                    </div>
                </LoggedInTemplate>
            </asp:LoginView>
        </div>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer -->
        <footer>
            <p>&copy; <%: DateTime.Now.Year %> Khwezi Driving School. All rights reserved.</p>
        </footer>
    </form>
</body>
</html>


